# Firebase configuration
# Copy this file to `.env` and fill in the values from your Firebase project.
# In the Firebase console, go to Project Settings > General > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare Worker bridge (Phase 2). Points the frontend at the deployed
# /api/generate endpoint, e.g. https://faceless-worker.your-subdomain.workers.dev
VITE_WORKER_URL=

# TikTok OAuth (Phase 5). Used to build the "Login with TikTok" authorize URL.
VITE_TIKTOK_CLIENT_KEY=
# Must exactly match the redirect_uri registered in the TikTok Developer Portal:
#   <your-site-url>/#/tiktok/callback
VITE_TIKTOK_REDIRECT_URI=
